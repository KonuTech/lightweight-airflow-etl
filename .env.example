# Copy this file to `.env` before running `docker compose up` (required first-clone step, D-09).
# The real `.env` is gitignored -- never commit actual credential values.
#
# NOTE (D-07, RESEARCH.md Assumption A2): ORACLE_PASSWORD (the Oracle SYS/SYSTEM account) and
# ORACLE_APP_USER_PASSWORD (the dedicated APP_USER application schema account) are two distinct
# Oracle accounts. Both are set to the same literal "admin" value here purely for local-dev
# single-credential convenience (INFRA-03) -- they are not the same account and are never
# collapsed into one.

# Oracle SYS/SYSTEM account password
ORACLE_PASSWORD=admin

# Oracle dedicated application schema/user (owns INGESTION_METADATA and all data tables)
ORACLE_APP_USER=admin
ORACLE_APP_USER_PASSWORD=admin

# Matches the base apache/airflow image's non-root `airflow` user uid -- avoids bind-mount
# permission friction on ./airflow/dags.
AIRFLOW_UID=50000
